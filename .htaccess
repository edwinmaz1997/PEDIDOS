# OneSignal Service Worker — acceso sin restricciones
<Files "OneSignalSDKWorker.js">
    Order Allow,Deny
    Allow from all
    Satisfy Any
    Header set Service-Worker-Allowed "/"
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Access-Control-Allow-Origin "*"
</Files>

<Files "OneSignalSDK.sw.js">
    Order Allow,Deny
    Allow from all
    Satisfy Any
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Access-Control-Allow-Origin "*"
</Files>

# Tipos MIME para video
<IfModule mod_mime.c>
    AddType video/mp4  .mp4
    AddType video/webm .webm
    AddType video/quicktime .mov
</IfModule>

Options -Indexes
RewriteEngine On

# ── Seguridad: bloquear acceso directo a archivos internos ──
# Archivos y carpetas ocultas (.git, .env, .htpasswd…)
RewriteRule (^|/)\.(?!well-known/) - [F,L]
# Código interno de la API: solo se entra por api/index.php
RewriteRule ^api/(config|controllers|helpers|middleware|libs|cron)(/|$) - [F,L]
RewriteRule ^api/(?!index\.php$)[^/]+\.php$ - [F,L]
# Respaldo y esquema de base de datos
RewriteRule ^database(/|$) - [F,L]
# No ejecutar PHP dentro de las subidas de usuarios
RewriteRule ^uploads/.*\.(php|phtml|phar|php\d|pl|py|cgi|sh)$ - [F,L,NC]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^api/.*$ api/index.php [QSA,L]

# Slugs de negocios: nuevaexpress.com/{slug} → pedido.html?business=ID
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/(cliente|negocio|admin|repartidor|api|assets|database)/
RewriteCond %{REQUEST_URI} !^/(index|404|nosotros|terminos|negocio|restablecer-contrasena|manifest|sw|OneSignal|favicon)
RewriteRule ^([a-zA-Z0-9_-]+)$ /go.php?slug=$1 [QSA,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(cliente|negocio|admin|repartidor)/(.*)$ /$1/$2 [L]

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options nosniff
    Header always set X-Frame-Options SAMEORIGIN
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy strict-origin-when-cross-origin
    Header unset X-Powered-By
    Header unset Server
</IfModule>

<FilesMatch "\.(sql|log|env|bak|php~|ini|sh|md|yml|yaml|lock)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Que el navegador siempre revise si hay versión nueva de páginas, estilos y scripts
<IfModule mod_headers.c>
  <FilesMatch "\.(html|css|js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<Files "DOCUMENTACION.txt">
    Order allow,deny
    Deny from all
</Files>
